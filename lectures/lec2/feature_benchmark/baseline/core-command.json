{
  "argv": [
    "python",
    "-m",
    "sktime.benchmarking.feature_extraction",
    "benchmark",
    "--config",
    "lectures/lec2/feature_benchmark/core.json",
    "--out",
    "outputs/lec2-core"
  ],
  "config": {
    "preset": "lec2-core",
    "seed": 42,
    "preprocessing": [],
    "parameters": {
      "acf": {
        "n_lags": 10
      },
      "pacf": {
        "n_lags": 10,
        "method": "ywadjusted"
      },
      "adf": {
        "maxlag": null,
        "regression": "c",
        "autolag": "AIC"
      },
      "permutation_entropy": {
        "dimension": 5,
        "tau": 1
      },
      "spectrum": {
        "sampling_rate": null,
        "rolloff": 0.85
      },
      "tsfresh": {
        "feature_set": "efficient"
      }
    }
  }
}
